# Copy to `.env` next to docker-compose.yml on the server and fill in every
# secret (generate each with `openssl rand -hex 32`). Never commit the real file.
APP_RELEASE=latest
APP_DOMAIN=tfcpms.tfcmockup.com
WEB_URL=https://tfcpms.tfcmockup.com

# Plane proxy binds to 127.0.0.1 on this port; CloudPanel's "App Port" must match.
LISTEN_HTTP_PORT=8090

SECRET_KEY=
LIVE_SERVER_SECRET_KEY=

POSTGRES_USER=plane
POSTGRES_DB=plane
POSTGRES_PASSWORD=

RABBITMQ_USER=plane
RABBITMQ_VHOST=plane
RABBITMQ_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=uploads

# Max upload size in bytes (keep CloudPanel's client_max_body_size at least this big).
FILE_SIZE_LIMIT=5242880
GUNICORN_WORKERS=2
